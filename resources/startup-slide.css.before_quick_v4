.startup-slide-screen{background:#04152b}
.startup-slide-art{position:absolute;left:50%;top:50%;width:min(100%,calc(var(--landscape-height) * 851 / 1847));height:min(100%,calc(var(--landscape-width) * 1847 / 851));aspect-ratio:851/1847;transform:translate(-50%,-50%);container-type:size}
.startup-slide-backdrop{display:block;width:100%;height:100%;max-width:none;object-fit:contain;user-select:none;pointer-events:none}
.startup-slide-track{touch-action:none;cursor:grab;position:absolute;left:16%;top:77.7%;width:67%;height:5.4%}
/* Extend the painting's empty blue surface behind the moving book. */
.startup-slide-wipe{position:absolute;left:26%;top:0;width:74%;height:100%;max-width:none;overflow:hidden;pointer-events:none;mask-image:linear-gradient(to bottom,transparent,#000 10%,#000 88%,transparent);clip-path:inset(0 var(--startup-wipe-right,100%) 0 0);transition:clip-path .3s ease}
.startup-slide-track.is-dragging .startup-slide-wipe{transition:none}
.startup-slide-book{position:absolute;left:0;top:0;width:26%;height:100%;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;transition:transform .3s ease;will-change:transform;filter:none}
.startup-slide-book.is-dragging{cursor:grabbing;transition:none}
.startup-slide-book svg{display:block;width:100%;height:100%;max-width:none;overflow:visible;pointer-events:none}
.startup-slide-book:focus-visible{outline:none;border:0;box-shadow:none}
@media(prefers-reduced-motion:reduce){.startup-slide-book,.startup-slide-wipe{transition:none}}

/* Decorative motion stays behind the accessible slide control and flying owl. */
.startup-scene-motion{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;border:0}
.startup-slide-track{z-index:2}
@media(prefers-reduced-motion:reduce){.startup-scene-motion{display:none}}

.startup-slide-book .startup-book-art{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none;background:transparent;border:0;box-shadow:none}

.startup-slide-book,.startup-slide-book:focus,.startup-slide-book .startup-book-art{border:0;outline:none;box-shadow:none;background:transparent}
