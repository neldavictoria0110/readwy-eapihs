/* The painting supplies the lettering and track; its book wipes the ink away. */
function renderStartupSlide(){
 app.innerHTML=`<section class="story-screen story-startup startup-slide-screen" aria-label="READwy — The Enchanted Academy of Reading"><div class="startup-slide-art"><img class="startup-slide-backdrop" src="resources/startup-slide-backdrop.png" alt="READwy — The Enchanted Academy of Reading. Slide to Begin." draggable="false"><object class="startup-scene-motion" type="image/svg+xml" data="resources/startup-scene-motion.svg" aria-hidden="true" tabindex="-1"></object><div class="startup-slide-track"><svg class="startup-slide-wipe" viewBox="260 1435 14 100" preserveAspectRatio="none" aria-hidden="true"><image href="resources/startup-slide-backdrop.png" width="851" height="1847"/></svg><div class="startup-slide-book" role="slider" tabindex="0" aria-label="Slide the book right to begin" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="Slide the book to the right end to begin"><img class="startup-book-art" src="resources/open-book.svg" alt="" draggable="false"></div></div></div></section>`;

 // READWY_TITLE_STARTUP_TRIGGER
 const titleScene=app.querySelector('.startup-scene-motion');

 function playStartupTitle(){
  if(!titleScene?.isConnected)return;

  const doc=titleScene.contentDocument;
  const root=doc?.documentElement;
  const letter=doc?.querySelector('.falling-letter');

  if(!root||!letter||!doc.defaultView)return;

  root.classList.remove('title-playing');
  root.classList.add('title-staged');

  void doc.defaultView.getComputedStyle(letter).opacity;

  requestAnimationFrame(()=>requestAnimationFrame(()=>{
   if(titleScene.isConnected){
    root.classList.add('title-playing');
   }
  }));
 }

 titleScene?.addEventListener('load',playStartupTitle,{once:true});

 if(titleScene?.contentDocument?.querySelector('.falling-letter')){
  playStartupTitle();
 }
 const track=app.querySelector('.startup-slide-track'),book=app.querySelector('.startup-slide-book');
 // READWY_SLIDER_FRAME_FIX_V3
 let progress=0,drag=null,completed=false,paintId=0;
 let travelCss=0,travelScreen=1,lastPercent=-1;

 function measure(){
  const rect=track.getBoundingClientRect();
  travelCss=Math.max(0,track.clientWidth-book.offsetWidth);
  const scale=rect.width/Math.max(1,track.clientWidth);
  travelScreen=Math.max(1,travelCss*scale);
 }

 function paint(){
  paintId=0;
  if(!book.isConnected)return;
  track.style.setProperty('--startup-wipe-right',(100-progress*100)+'%');
  book.style.transform='translate3d('+(progress*travelCss)+'px,0,0)';
 }

 function update(value){
  progress=Math.max(0,Math.min(1,value));
  const percent=Math.round(progress*100);

  if(percent!==lastPercent){
   lastPercent=percent;
   book.setAttribute('aria-valuenow',percent);
   book.setAttribute('aria-valuetext',percent+' percent. Slide right to begin.');
  }

  paint(); // READWY_SLIDER_DIRECT_FRAME_FIX
 }

 book.style.left='0px';
 measure();
 update(0);
 function finish(){
  if(completed||navigationBusy)return;
  completed=true;update(1);book.setAttribute('aria-valuetext','Complete. Opening the next page.');
  window.location.assign('index.html?view=train');
 }
 function reset(){book.classList.remove('is-dragging');track.classList.remove('is-dragging');update(0)}
 track.addEventListener('pointerdown',event=>{
  if(completed||navigationBusy||event.isPrimary===false||event.button!==0)return;
  event.preventDefault();
  book.focus({preventScroll:true});
  measure();
  track.setPointerCapture(event.pointerId);
  drag={id:event.pointerId,x:event.clientX,start:progress,travel:travelScreen};
  book.classList.add('is-dragging');track.classList.add('is-dragging');
 });
 track.addEventListener('pointermove',event=>{
  if(!drag||drag.id!==event.pointerId||completed)return;
  update(drag.start+(event.clientX-drag.x)/drag.travel);
  if(progress>=1){drag=null;finish()}
 });
 function release(event){if(drag?.id!==event.pointerId)return;drag=null;if(!completed){if(progress>=.95)finish();else reset()}}
 track.addEventListener('pointerup',release);
 track.addEventListener('pointercancel',release);
 track.addEventListener('lostpointercapture',release);
 book.addEventListener('keydown',event=>{
  if(completed||navigationBusy)return;
  if(!['ArrowRight','ArrowLeft','Home'].includes(event.key))return;
  event.preventDefault();
  update(event.key==='Home'?0:progress+(event.key==='ArrowRight'?.1:-.1));
  if(progress>=.999)finish();
 });
 const observer=new ResizeObserver(()=>{if(book.isConnected){measure();update(progress)}});
 observer.observe(track);
 renderStartupSlide.cleanup=()=>{observer.disconnect();if(paintId)cancelAnimationFrame(paintId)};
}
